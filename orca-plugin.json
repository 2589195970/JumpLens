{
  "manifestVersion": 2,
  "id": "jumplens",
  "name": "JumpLens · 代码导航",
  "version": "0.4.0",
  "description": "Java、Vue 与 JS/TS 代码导航、Java 语义着色和同版本 Git 提交阅读，提供 One Dark 与 IDEA 配色。",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "code-navigation",
        "title": "JumpLens",
        "extensions": [
          ".java",
          ".vue",
          ".ts",
          ".tsx",
          ".mts",
          ".cts",
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "entry": "dist/editor.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "commit-review",
        "title": "JumpLens 提交阅读",
        "extensions": [
          ".jumplens-review"
        ],
        "entry": "dist/review.html",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "settings": [
      {
        "key": "javaHome",
        "title": "语言服务 JDK 目录",
        "description": "Java 25 或更高版本。留空时自动准备独立运行环境。",
        "type": "string",
        "default": ""
      },
      {
        "key": "projectJavaHome",
        "title": "项目 JDK 目录",
        "description": "用于分析项目的 JDK。留空时在 macOS 上优先识别已安装的 Java 8。",
        "type": "string",
        "default": ""
      },
      {
        "key": "languageServerHome",
        "title": "JDT LS 目录",
        "description": "留空时自动准备 Eclipse JDT LS 1.63.0。",
        "type": "string",
        "default": ""
      },
      {
        "key": "syntaxPalette",
        "title": "代码配色",
        "description": "源码、候选预览与提交阅读使用的符号配色；原生 Git 差异在外观设置中选择同名 JumpLens 编辑器主题。",
        "type": "string",
        "default": "onedark",
        "enum": [
          "onedark",
          "idea"
        ],
        "enumLabels": [
          "One Dark",
          "IDEA Dark"
        ]
      }
    ],
    "newFiles": [
      {
        "id": "commit-review",
        "title": "JumpLens 提交阅读",
        "extension": ".jumplens-review",
        "template": "dist/review-template.json"
      }
    ],
    "syntaxes": [
      {
        "id": "java",
        "title": "JumpLens Java",
        "scopeName": "source.java",
        "path": "syntaxes/java.tmLanguage.json",
        "configuration": "syntaxes/java-configuration.json",
        "extensions": [
          ".java"
        ]
      }
    ],
    "themes": [
      {
        "id": "onedark",
        "title": "JumpLens One Dark",
        "path": "themes/onedark.json"
      },
      {
        "id": "idea",
        "title": "JumpLens IDEA Dark",
        "path": "themes/idea.json"
      }
    ]
  },
  "author": {
    "name": "2589195970",
    "url": "https://github.com/2589195970"
  },
  "repository": "https://github.com/2589195970/JumpLens",
  "homepage": "https://github.com/2589195970/JumpLens",
  "license": "MIT"
}
