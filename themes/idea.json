{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#1e1f22",
    "--editor-surface": "#1e1f22",
    "--foreground": "#bcbec4"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#2aacb8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "storage.type.java",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.method-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "variable.other.member",
        "variable.other.field"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d5b778"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#b3ae60"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#92969e"
      }
    }
  ]
}
