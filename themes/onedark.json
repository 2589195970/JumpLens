{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#282c34",
    "--editor-surface": "#282c34",
    "--foreground": "#abb2bf"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "storage.type.java",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.method-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "variable.other.member",
        "variable.other.field"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7f848e"
      }
    }
  ]
}
